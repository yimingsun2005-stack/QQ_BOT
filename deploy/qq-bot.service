[Unit]
Description=QQ_BOT server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qqbot
Group=qqbot
WorkingDirectory=/opt/QQ_BOT
Environment=BOT_CONFIG=/etc/qq-bot/config.json
Environment=LOG_LEVEL=INFO
ExecStart=/opt/QQ_BOT/.venv/bin/python /opt/QQ_BOT/bot.py
Restart=on-failure
RestartPreventExitStatus=1 2
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/qq-bot

[Install]
WantedBy=multi-user.target
